diff --git a/src/PsyX_main.cpp b/src/PsyX_main.cpp
index e847dd5..194b98b 100644
--- a/src/PsyX_main.cpp
+++ b/src/PsyX_main.cpp
@@ -225,6 +225,11 @@ int intrThreadMain(void* data)
 		 * g_SpuMutex (never nested under g_intrMutex), throttles on the
 		 * SDL_GetTicks ms delta, no-op unless `adsr 1`. */
 		PsyX_SPUAL_Update();
+
+#if defined(__ANDROID__)
+		/* Yield on mobile so the timing loop cannot monopolise a CPU core. */
+		SDL_Delay(1);
+#endif
 	}
 
 	return 0;
@@ -237,20 +242,25 @@ static int PsyX_Sys_InitialiseCore()
 	Util_InitHPCTimer(&g_vblTimer);
 #else
 
+	g_intrMutex = SDL_CreateMutex();
+	if (NULL == g_intrMutex)
+	{
+		eprinterr("SDL_CreateMutex failed: %s\n", SDL_GetError());
+		return 0;
+	}
+
+	/* The interrupt thread locks g_intrMutex immediately. Create the mutex
+	 * first to avoid a startup race that can dereference NULL on Android. */
 	g_intrThread = SDL_CreateThread(intrThreadMain, "psyX_intr", NULL);
 
 	if (NULL == g_intrThread)
 	{
 		eprinterr("SDL_CreateThread failed: %s\n", SDL_GetError());
+		SDL_DestroyMutex(g_intrMutex);
+		g_intrMutex = NULL;
 		return 0;
 	}
-	
-	g_intrMutex = SDL_CreateMutex();
-	if (NULL == g_intrMutex)
-	{
-		eprinterr("SDL_CreateMutex failed: %s\n", SDL_GetError());
-		return 0;
-	}
 #endif
 	return 1;
 }
@@ -628,10 +638,10 @@ void PrintMessageToOutput(SpewType_t spewtype, char const* pMsgFormat, va_list a
 	}
 #else
-	printf(pTempBuffer);
+	printf("%s", pTempBuffer);
 #endif
 
 	if(g_logStream)
-		fprintf(g_logStream, pTempBuffer);
+		fprintf(g_logStream, "%s", pTempBuffer);
 }
 
